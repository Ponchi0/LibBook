<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_Filter"
        style="@style/Widget.App.MaterialButton"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="Filter"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text=""
        app:icon="@drawable/ic_filter"
        app:iconPadding="0dp"
        app:iconSize="28dp"
        app:iconTint="@color/text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TouchTargetSizeCheck" />
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:hint="Поиск"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:singleLine="true"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawableTint="@color/text_primary"
        android:drawablePadding="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:minHeight="36dp"
        android:background="@drawable/bg_search_field"
        android:textColor="@color/text_primary"
        android:textColorHint="?android:attr/textColorHint"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_Filter"
        tools:ignore="TouchTargetSizeCheck" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCenter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomAppBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintVertical_bias="0.0"
        tools:listitem="@layout/item_book" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/catalog_empty"
        android:textAlignment="center"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomAppBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintVertical_bias="0.5"
        tools:visibility="visible" />

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:fabCradleMargin="0dp"
        app:fabCradleRoundedCornerRadius="0dp"
        app:fabCradleVerticalOffset="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="BottomAppBar">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_app_bar_height"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="0dp"
            android:paddingEnd="0dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cgMarkbooks"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:text="Закладки"
                android:textSize="10sp"
                android:textColor="@color/text_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:icon="@drawable/ic_bookmark"
                app:iconTint="@color/text_primary"
                app:iconSize="24dp"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                tools:ignore="TouchTargetSizeCheck" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cgCatalog"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="Каталог"
                android:textSize="10sp"
                android:textColor="@color/text_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:icon="@drawable/ic_catalog"
                app:iconTint="@color/text_primary"
                app:iconSize="20dp"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                tools:ignore="TouchTargetSizeCheck" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cgMainMenu"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="Главная"
                android:textSize="10sp"
                android:textColor="@color/text_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:icon="@drawable/ic_home"
                app:iconTint="@color/text_primary"
                app:iconSize="20dp"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                tools:ignore="TouchTargetSizeCheck" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cgGeneral"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="@string/nav_bottom_menu"
                android:textSize="10sp"
                android:textColor="@color/text_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:icon="@drawable/ic_general"
                app:iconTint="@color/text_primary"
                app:iconSize="20dp"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>
    </com.google.android.material.bottomappbar.BottomAppBar>
</androidx.constraintlayout.widget.ConstraintLayout>
