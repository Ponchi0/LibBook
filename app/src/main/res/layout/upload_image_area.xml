<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <View
        android:id="@+id/uploadDimBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_vertical_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.16666667" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_vertical_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.83333333" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_horizontal_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.16666667" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_horizontal_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.83333333" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/uploadImageSurface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/upload_image_surface_description"
        android:elevation="8dp"
        app:cardBackgroundColor="#F0F0F0"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="#CCCCCC"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="@id/guide_horizontal_end"
        app:layout_constraintEnd_toEndOf="@id/guide_vertical_end"
        app:layout_constraintStart_toStartOf="@id/guide_vertical_start"
        app:layout_constraintTop_toTopOf="@id/guide_horizontal_start">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tvUploadImageHint1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <TextView
                android:id="@+id/tvUploadImageHint2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:padding="16dp"
                android:text="Загрузите картинку"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
