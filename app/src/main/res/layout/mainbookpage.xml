<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ratingBarRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/mbpimgCover"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:src="@drawable/icon_null"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintDimensionRatio="H,4:3"/>

            <LinearLayout
                android:id="@+id/topButtonsRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/mbpimgCover"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_weight="1">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mbpbtnAddBookmark"
                        style="@style/Widget.App.MaterialButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="В закладки"
                        android:textColor="@color/text_primary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mbpbtnRead"
                    style="@style/Widget.App.MaterialButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Читать"
                    android:textColor="@color/text_primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:maxLines="3"
                android:ellipsize="end"
                app:layout_constraintTop_toBottomOf="@id/topButtonsRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/mbpbtnDescriptionMore"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ещё"
                android:textColor="@color/text_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintStart_toStartOf="@id/tvDescription" />

            <TextView
                android:id="@+id/mbptvTags"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                app:layout_constraintTop_toBottomOf="@id/mbpbtnDescriptionMore"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/mbpbtnTagsMore"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ещё"
                android:textColor="@color/text_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:layout_constraintTop_toBottomOf="@id/mbptvTags"
                app:layout_constraintStart_toStartOf="@id/mbptvTags" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/ratingBarRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomAppBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvRateLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/book_rate_label"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBookRating"
            style="@style/Widget.App.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:hint="@string/book_rating_hint">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actBookRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/book_rating_hint"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mbpbtnSubmitRating"
            style="@style/Widget.App.MaterialButton.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:contentDescription="@string/book_rate_label"
            android:text=""
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/text_primary" />
    </LinearLayout>

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:fabCradleMargin="0dp"
        app:fabCradleRoundedCornerRadius="0dp"
        app:fabCradleVerticalOffset="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="BottomAppBar">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_app_bar_height"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="0dp"
            android:paddingEnd="0dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mbpMarkbooks"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:text="Закладки"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textSize="10sp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_bookmark"
                app:iconTint="@color/text_primary"
                app:iconSize="24dp"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                tools:ignore="TouchTargetSizeCheck" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mbpCatalog"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="Каталог"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textSize="10sp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_catalog"
                app:iconTint="@color/text_primary"
                app:iconSize="20dp"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                tools:ignore="TouchTargetSizeCheck" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mbpMainMenu"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="Главная"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textSize="10sp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_home"
                app:iconTint="@color/text_primary"
                app:iconSize="20dp"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                tools:ignore="TouchTargetSizeCheck" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mbpGeneral"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="@string/nav_bottom_menu"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textSize="10sp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_general"
                app:iconTint="@color/text_primary"
                app:iconGravity="textTop"
                app:iconSize="20dp"
                app:iconPadding="4dp"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>
    </com.google.android.material.bottomappbar.BottomAppBar>

</androidx.constraintlayout.widget.ConstraintLayout>
