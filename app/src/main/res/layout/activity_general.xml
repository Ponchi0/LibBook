<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgUser"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:contentDescription="User avatar"
        android:scaleType="centerCrop"
        android:src="@drawable/icon_null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.UserAvatar" />
    <TextView
        android:id="@+id/txtUserName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/imgUser"
        app:layout_constraintTop_toTopOf="@id/imgUser"
        app:layout_constraintBottom_toBottomOf="@id/imgUser"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/name_null"
        />
    <LinearLayout
        android:id="@+id/actionsColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/imgUser"
        app:layout_constraintBottom_toTopOf="@id/authButtonsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddBook"
            style="@style/Widget.App.MaterialButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добавить книгу"
            android:textColor="@color/text_primary"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_plus"
            app:iconTint="@color/text_primary"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditBook"
            style="@style/Widget.App.MaterialButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit_book_button"
            android:textColor="@color/text_primary"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@android:drawable/ic_menu_edit"
            app:iconTint="@color/text_primary"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteBook"
            style="@style/Widget.App.MaterialButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delete_book_button"
            android:textColor="@color/text_primary"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@android:drawable/ic_menu_delete"
            app:iconTint="@color/text_primary"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_Info"
            style="@style/Widget.App.MaterialButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Информация"
            android:textColor="@color/text_primary"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@android:drawable/ic_menu_info_details"
            app:iconTint="@color/text_primary"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_Settings"
            style="@style/Widget.App.MaterialButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Настройки"
            android:textColor="@color/text_primary"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@android:drawable/ic_menu_edit"
            app:iconTint="@color/text_primary"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/authButtonsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomAppBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/guestAuthRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistration"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Регистрация"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignIn"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Войти"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:fabCradleMargin="0dp"
        app:fabCradleRoundedCornerRadius="0dp"
        app:fabCradleVerticalOffset="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="BottomAppBar">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_app_bar_height"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="0dp"
            android:paddingEnd="0dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_glMarkbooks"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:text="Закладки"
                android:textSize="10sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_bookmark"
                app:iconTint="@color/text_primary"
                app:iconSize="24dp"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                tools:ignore="TouchTargetSizeCheck" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_glCatalog"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="Каталог"
                android:textSize="10sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_catalog"
                app:iconTint="@color/text_primary"
                app:iconSize="20dp"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                tools:ignore="TouchTargetSizeCheck" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_glMainMenu"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="Главная"
                android:textSize="10sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_home"
                app:iconTint="@color/text_primary"
                app:iconSize="20dp"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                tools:ignore="TouchTargetSizeCheck" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_glGeneral"
                style="@style/Widget.App.MaterialButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="@string/nav_bottom_menu"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textSize="10sp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_primary"
                app:icon="@drawable/ic_general"
                app:iconTint="@color/text_primary"
                app:iconSize="20dp"
                app:iconGravity="textTop"
                app:iconPadding="4dp"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>
    </com.google.android.material.bottomappbar.BottomAppBar>
</androidx.constraintlayout.widget.ConstraintLayout>
